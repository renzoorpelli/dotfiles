shell-integration = fish

# >>> themes
#theme  = flexoki dark
#theme  = Solarized Dark Higher Contrast
#theme  = flexoki dark
#theme  = Solarized Dark Patched
#theme  = One Dark
#theme 	= One Double Dark
#theme  = gruvbox dark
#theme  = Vesper
#theme  = Jellybeans
#theme  = Nvim Dark
#theme = Vesper
theme = Rose Pine
# <<< themes

#background = #031219  -- Solarized
background = #0d0c0c
background-opacity = 0.95
#background-blur-radius = 20

cursor-style = block
cursor-style-blink = true

#font-family  = Monaco
#font-family  = Menlo
#font-family  = Source Code Pro
#font-family  = FiraCode Nerd Font
#font-family  = UbuntuSansMono Nerd Font Propo
font-family  = UbuntuSansMono Nerd Font
#font-family  = UbuntuMono Nerd Font
#font-family  = BerkeleyMono Nerd Font Mono
#font-family  = DejaVuSansM Nerd Font Mono
#font-family   = PlemolJP35 Console NF
#font-family  = PlemolJP Console NF
#font-family  = AdwaitaMono Nerd Font Regular

font-feature = -calt, -liga, -dlig
font-size = 16

keybind = ctrl+n=new_window
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top

keybind = ctrl+l=goto_split:right

# Native splits for local work
keybind = command+shift+h=new_split:left
keybind = command+shift+j=new_split:down
keybind = command+shift+k=new_split:up
keybind = command+shift+l=new_split:right
keybind = command+shift+f=toggle_split_zoom

# Native tab navigation
keybind = ctrl+shift+n=next_tab
keybind = ctrl+shift+p=previous_tab
keybind = ctrl+t=new_tab
#keybind = ctrl+w=close_surface

keybind = super+r=reload_config

# Window
window-padding-x = 12
window-padding-y = 12
